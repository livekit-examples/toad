# LiveKit project credentials (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: name of the agent to dispatch explicitly (matches `agent_name` in your agent's WorkerOptions/ServerOptions).
# Leave empty to rely on automatic dispatch.
AGENT_NAME=

# Optional: base URL of Dev B's Iris backend for the inbox. Leave empty to use the in-app fixture
# backend at /api/mock (which is disabled whenever this is set).
NEXT_PUBLIC_IRIS_API_URL=
