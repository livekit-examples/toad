# LiveKit project credentials (https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: name of the agent to dispatch explicitly (matches `agent_name` in your agent's WorkerOptions/ServerOptions).
# Leave empty to rely on automatic dispatch.
AGENT_NAME=
